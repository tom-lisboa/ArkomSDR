# Local development only. Copy to .env; generate BIA_API_TOKEN with openssl rand -hex 32.
BIA_DATABASE_URL=postgres://bia:bia_local_only@127.0.0.1:54329/bia?sslmode=disable
BIA_API_TOKEN=
BIA_ADDR=127.0.0.1:8080
BIA_MODE=shadow
BIA_BRAND=Grupo Bilhon
BIA_TIMEZONE=America/Cuiaba
BIA_SCHEDULING_URL=https://example.invalid/agendar
BIA_WORKERS=4

# Optional. Without a key the limited deterministic planner is used.
# Select a model supported by your own API account; no model is guessed.
OPENAI_API_KEY=
OPENAI_MODEL=
OPENAI_AUDIO_MODEL=
BIA_MEDIA_HOSTS=

# Future integration: see docs/integrations.md. Not used in shadow mode.
BIA_GATEWAY_URL=
BIA_GATEWAY_TOKEN=

# Direct Twilio WhatsApp messaging; gateway remains the default for compatibility.
BIA_MESSAGING_PROVIDER=gateway
# When set, all Twilio messages/calls are restricted to this E.164 number.
# It permits that explicitly requested test outside quiet hours and suppresses
# scheduled followups/reminders. Clear only when broader operation is authorized.
BIA_TEST_PHONE=

# Context worker: Redis buffers fragments; Postgres remains authoritative.
BIA_REDIS_URL=redis://127.0.0.1:6389/0
# Explicit model with image/PDF support, used only by the media worker.
OPENAI_MEDIA_MODEL=

# Sixth worker: native WhatsApp call permission + Twilio Media Streams + OpenAI Realtime.
# Off by default. See docs/voice.md before enabling; these are not PSTN calls.
BIA_VOICE_ADDR=127.0.0.1:8081
BIA_VOICE_ENABLED=false
BIA_VOICE_AUTO_REQUEST=false
BIA_VOICE_APPROVED_OUTSIDE_SESSION=false
BIA_VOICE_PUBLIC_URL=
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_WHATSAPP_FROM=
TWILIO_CALL_PERMISSION_CONTENT_SID=
OPENAI_REALTIME_MODEL=
OPENAI_REALTIME_VOICE=marin
OPENAI_REALTIME_TRANSCRIPTION_MODEL=

# Batch split WhatsApp messages before one execution (durations: 1s..5m).
BIA_CONTEXT_QUIET=5s
BIA_CONTEXT_MEDIA_QUIET=12s
BIA_CONTEXT_MEDIA_SETTLE=3s
BIA_CONTEXT_MAX_WAIT=30s
BIA_CONTEXT_MEDIA_TIMEOUT=120s

# Public test-form capability. Generate a separate key, never reuse BIA_API_TOKEN.
BIA_TEST_FORM_TOKEN=
# Submit -> durable contact job, without requiring the user to message first.
# Outside the WhatsApp service window, the text template must be approved.
BIA_FORM_AUTO_CONTACT=false

# One contextual specialist per WhatsApp turn; Decisions classifies the input.
# Responses keeps the configured OPENAI_MODEL for generation. See docs/specialists.md.
BIA_SPECIALISTS_ENABLED=false
OPENAI_DECISIONS_MODEL=gpt-6-luna
TWILIO_FORM_CONTACT_CONTENT_SID=
# Case video immediately after delivery of the initial opening, once per contact.
# Install the MP4 and approve its own media template before enabling.
BIA_INTRO_VIDEO_ENABLED=false
BIA_INTRO_VIDEO_DIR=.local/media/cases
BIA_INTRO_VIDEO_SHA256=
TWILIO_INTRO_VIDEO_CONTENT_SID=
# Keep scheduled campaigns disabled while testing inbound conversations.
BIA_DISABLE_FOLLOWUPS=true
BIA_PER_LEAD_DAILY=15
BIA_GLOBAL_HOURLY=60

# Meeting cadence, independent from legacy followups: audio T-30, text + call
# permission T-15, one call after acceptance and strictly before the meeting.
# Enable only after installing the user's recording; see docs/followups.md.
BIA_MEETING_REMINDERS_ENABLED=false
BIA_MEETING_START_ENABLED=false
TWILIO_MEETING_START_CONTENT_SID=
BIA_SMS_REMINDERS_ENABLED=false
TWILIO_SMS_FROM=
BIA_REMINDER_AUDIO_DIR=.local/media/reminders
BIA_REMINDER_AUDIO_SHA256=

# Optional recurring capacity in the Go-owned calendar (disabled by default).
BIA_LOCAL_CALENDAR_ENABLED=false
BIA_LOCAL_CALENDAR_TIMEZONE=America/Cuiaba
BIA_LOCAL_CALENDAR_WINDOWS=08:00-12:00,14:00-20:00
BIA_LOCAL_CALENDAR_DURATION_MINUTES=45
BIA_LOCAL_CALENDAR_DAYS=14
BIA_LOCAL_CALENDAR_CLOSER_ID=1
# Empty is allowed for database-only reservations; no external invitation is sent.
BIA_LOCAL_CALENDAR_MEETING_URL=

# Short booking confirmation; both fields may use the same approved template.
TWILIO_BOOKED_CONTACT_CONTENT_SID=
TWILIO_BOOKED_QUESTION_CONTENT_SID=
# Separate second bubble, with and without a known goal.
TWILIO_FORM_CONTEXT_CONTENT_SID=
TWILIO_FORM_CONTEXT_QUESTION_CONTENT_SID=

# Preparation 15 minutes after the successful opening, for an upcoming booking.
BIA_MEETING_PREPARATION_ENABLED=false
TWILIO_PREPARATION_CONTENT_SID=

# Native WhatsApp quick replies; deploy/quick-replies contains the Content assets.
# Session-only generic assets stay unsubmitted; the other five require approval.
BIA_QUICK_REPLIES_ENABLED=false
TWILIO_QUICK_REPLY_1_SID=
TWILIO_QUICK_REPLY_2_SID=
TWILIO_QUICK_REPLY_3_SID=
TWILIO_FORM_BUTTONS_SID=
TWILIO_CONTEXT_BUTTONS_SID=
TWILIO_CONTEXT_QUESTION_BUTTONS_SID=
TWILIO_PREPARATION_BUTTONS_SID=
TWILIO_MEETING_START_BUTTONS_SID=

# Staff management API; users and sessions are separate from BIA_API_TOKEN.
BIA_MANAGEMENT_ENABLED=false
# Exact frontend origins, comma-separated. The configured public URL is allowed.
# Example: https://painel.example.com,http://localhost:3000
BIA_MANAGEMENT_ORIGINS=
